# Public listen. Node gold standard stays on 8080.
HOST=127.0.0.1
PORT=8081

# Cursor user/service API key (same class as CURSOR_API_KEY for @cursor/sdk).
CURSOR_API_KEY=

# Optional path to a pinned cursor-sdk-bridge binary (sdk.v1).
# Download from https://github.com/cursor/sdk-bridge/releases
CURSOR_SDK_BRIDGE=
