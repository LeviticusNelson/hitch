# Public listen. Node gold standard stays on 8080.
HOST=127.0.0.1
PORT=8081

# Cursor user/service API key (same class as CURSOR_API_KEY for @cursor/sdk).
# If unset, the gateway uses a local fake driver (HTTP protocols still work).
CURSOR_API_KEY=

# Optional path to a pinned cursor-sdk-bridge binary (sdk.v1 1.0.30).
# ./scripts/fetch-bridge.sh installs to ~/.cursor-sdk2api-zig/bridge/v1.0.30/bin/cursor-sdk-bridge
CURSOR_SDK_BRIDGE=

# byok (default) or managed. Managed accepts GATEWAY_ACCESS_KEY and loopback OIDC.
AUTH_MODE=byok
GATEWAY_ACCESS_KEY=
MANAGED_CURSOR_KEY=

# Force the fake Cursor driver even if a key is set.
FAKE_CURSOR=0

# Active-run caps. Daily-driver Grok shares one Cursor key, so per-key
# defaults to the global cap. Tool-result continuation and local compact
# do not consume a slot. CAPACITY_WAIT_MS waits instead of instant 429.
MAX_ACTIVE_RUNS=32
MAX_RUNS_PER_KEY=32
CAPACITY_WAIT_MS=15000
CAPACITY_POLL_MS=200

# Load Cursor user/project/plugin MCP servers into the agent. When a client
# MCP tool result looks like a connection failure, hitch retries that call
# against ~/.cursor/mcp.json. Set off to disable.
HITCH_CURSOR_MCP=fallback

# Catalog is always native HTTPS to api.cursor.com when CURSOR_API_KEY is set.
# Do not use Cloud Agents. Inference still needs the official local sdk-bridge.
STATE_DIR=
WORKSPACE_DIR=
